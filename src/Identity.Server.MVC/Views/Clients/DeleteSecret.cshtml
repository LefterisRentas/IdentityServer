@model Identity.Server.Extended.Models.Clients.ClientSecretDto

@{
    ViewData["Title"] = "Delete Client Secret";
    ViewData["Description"] = "Confirm the deletion of the client secret.";
}

<div class="container mx-auto px-4 py-6 md:flex">
    <partial name="_ManagementNav" />

    <section class="bg-white dark:bg-gray-900">
        <div class="max-w-2xl px-4 py-8 mx-auto lg:py-16">
            <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Delete Client Secret</h2>
            <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
                Are you sure you want to delete the following secret? This action cannot be undone.
            </p>
            <div class="mb-4">
                <div class="sm:col-span-2">
                    <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Type</label>
                    <p class="text-sm text-gray-600 dark:text-gray-400">@Model.Type</p>
                </div>
                <div class="sm:col-span-2">
                    <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                    <p class="text-sm text-gray-600 dark:text-gray-400">@Model.Description</p>
                </div>
                <div class="sm:col-span-2">
                    <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Expiration</label>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        @if (Model.Expiration is not null)
                        {
                        @Model.Expiration?.ToString("yyyy-MM-dd HH:mm")
                        }
                        else
                        {
                        <span>Never</span>
                        }
                    </p>
                </div>
            </div>
            <form asp-action="DeleteSecret" method="post">
                <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
                <input type="hidden" name="secretId" value="@Model.Id" />
                <div class="flex items-center space-x-4">
                    <button type="submit" class="text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900">
                        Delete Secret
                    </button>
                    <a asp-action="Secrets" asp-route-clientId="@ViewBag.ClientId" class="text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white focus:ring-4 focus:outline-none focus:ring-gray-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:focus:ring-gray-700">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </section>
</div>
