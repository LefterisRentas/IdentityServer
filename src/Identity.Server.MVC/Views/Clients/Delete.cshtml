@model Identity.Server.Extended.Models.Clients.ClientDto

@{
    ViewData["Title"] = $"Delete Client: {Model.ClientName}";
    ViewData["Description"] = $"Delete the client {Model.ClientName} in the Identity Server.";
}

<div class="mx-auto px-4 py-6 md:flex">
    <partial name="_ManagementNav" />

    <section class="bg-white dark:bg-gray-900">
        <div class="max-w-2xl px-4 py-8 mx-auto lg:py-16">
            <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Delete Client</h2>
            <div class="bg-gray-100 dark:bg-gray-800 rounded-lg p-4">
                <!-- Display Logo -->
                @if (!string.IsNullOrEmpty(Model.LogoUri))
                {
                    <img class="w-24 h-24 mx-auto rounded-full mb-4" src="@Model.LogoUri" alt="@Model.ClientName Logo">
                }

                <!-- Display Client Name -->
                <p class="text-lg font-medium text-gray-900 dark:text-white text-center">@Model.ClientName</p>

                <!-- Display Client ID -->
                <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-4">Client ID: <strong>@Model.ClientId</strong></p>

                <!-- Display Other Details -->
                <ul class="text-gray-700 dark:text-gray-300 text-sm space-y-2">
                    <li><strong>Enabled:</strong> @(Model.Enabled ? "Yes" : "No")</li>
                    <li><strong>Protocol Type:</strong> @Model.ProtocolType</li>
                    <li><strong>Front Channel Logout URI:</strong> @(!string.IsNullOrEmpty(Model.FrontChannelLogoutUri) ? Model.FrontChannelLogoutUri : "Not Set")</li>
                    <li><strong>Description:</strong> @(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "No description available.")</li>
                </ul>
            </div>

            <!-- Confirmation Message -->
            <div class="text-center mt-6">
                <p class="text-sm text-gray-700 dark:text-gray-300">Are you sure you want to delete this client? This action cannot be undone.</p>
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-center mt-6 space-x-4">
                <form asp-action="Delete" asp-controller="Clients" method="post">
                    <input type="hidden" name="ClientId" value="@Model.ClientId" />
                    <button type="submit" class="text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-900">
                        Confirm Delete
                    </button>
                </form>
                <a href="@Url.Action("Edit", "Clients", new { clientId = Model.ClientId })" class="text-gray-900 bg-gray-200 hover:bg-gray-300 focus:ring-4 focus:outline-none focus:ring-gray-400 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-800">
                    Cancel
                </a>
            </div>
        </div>
    </section>
</div>
