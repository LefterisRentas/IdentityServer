@model Identity.Server.Extended.Models.Clients.ClientSecretsDto

@{
    ViewData["Title"] = "Client Secrets Management";
    var clientId = ViewBag.Id;
    var currentPage = ViewBag.Page ?? 1;
    var maxPage = ViewBag.MaxPage ?? 1;
}

<div class="container mx-auto px-4 py-6 md:flex">
    <partial name="_ManagementNav"/>

    <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
            Client Secret Management for Client: @ViewBag.ClientId
        </h1>

        <!-- Create Secret Button -->
        <div class="mt-4">
            <a href="@Url.Action("CreateSecret", "Clients", new { clientId })">
                <button class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-green-400 to-blue-600 group-hover:from-green-400 group-hover:to-blue-600 hover:text-white dark:text-white focus:ring-4 focus:outline-none focus:ring-green-200 dark:focus:ring-green-800">
                    <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-opacity-0">
                        Create Client Secret
                    </span>
                </button>
            </a>
        </div>

        <!-- Secrets Table -->
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg mt-4">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th scope="col" class="px-4 py-2">Type</th>
                    <th scope="col" class="px-4 py-2">Description</th>
                    <th scope="col" class="px-4 py-2">Expiration</th>
                    <th scope="col" class="px-4 py-2">Actions</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.ClientSecrets.Any())
                {
                    @foreach (var secret in Model.ClientSecrets)
                    {
                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                            <td class="px-4 py-2 text-gray-900 dark:text-white">@secret.Type</td>
                            <td class="px-4 py-2">@secret.Description</td>
                            <td class="px-4 py-2">
                                @if (secret.Expiration is not null)
                                {
                                    @secret.Expiration?.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span>Never</span>
                                }
                            </td>
                            <td class="px-4 py-2">
                                <a href="@Url.Action("DeleteSecret", "Clients", new { clientId, secretId = secret.Id })"
                                   class="text-red-600 hover:text-red-800 dark:text-red-500 dark:hover:text-red-400">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-4 py-2 text-center text-gray-500 dark:text-gray-400">
                            No secrets found for this client.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (maxPage > 1)
        {
            <nav class="flex items-center justify-between pt-4" aria-label="Table navigation">
                <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
                    Page
                    <span class="font-semibold text-gray-900 dark:text-white">
                        @currentPage
                    </span>
                    of
                    <span class="font-semibold text-gray-900 dark:text-white">@maxPage</span>
                </span>
                <ul class="inline-flex -space-x-px text-sm h-8">
                    <!-- Previous Link -->
                    <li>
                        <a href="@(currentPage > 1 ? Url.Action("Secrets", new { clientId, page = currentPage - 1 }) : null)"
                           class="px-3 h-8 flex items-center justify-center leading-tight border border-gray-300 rounded-l-lg 
                  @(currentPage > 1 ? "text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" : "cursor-not-allowed text-gray-300 bg-gray-200 dark:bg-gray-700 dark:text-gray-500")">
                            Previous
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int i = currentPage - 2; i <= currentPage + 2; i++)
                    {
                        if (i > 0 && i <= maxPage)
                        {
                            <li>
                                <a href="@Url.Action("Secrets", new { clientId, page = i })"
                                   class="px-3 h-8 flex items-center justify-center leading-tight border border-gray-300 
                      @(i == currentPage ? "text-white bg-blue-600 hover:bg-blue-700" : "text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white")">
                                    @i
                                </a>
                            </li>
                        }
                    }

                    <!-- Next Link -->
                    <li>
                        <a href="@(currentPage < maxPage ? Url.Action("Secrets", new { clientId, page = currentPage + 1 }) : null)"
                           class="px-3 h-8 flex items-center justify-center leading-tight border border-gray-300 rounded-r-lg 
                  @(currentPage < maxPage ? "text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white" : "cursor-not-allowed text-gray-300 bg-gray-200 dark:bg-gray-700 dark:text-gray-500")">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>