@using IdentityServer4.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Identity.Server.Extended.Models.Clients.ClientDto

@{
ViewData["Title"] = "Create a Client";
ViewData["Description"] = "Create a new client in the Identity Server.";
}

<div class="mx-auto px-4 py-6 md:flex">
    <partial name="_ManagementNav"/>
    <section class="bg-white dark:bg-gray-900">
        <div class="max-w-2xl px-4 py-8 mx-auto lg:py-16">
            <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Update Client</h2>
            <form asp-action="Create" asp-controller="Clients" method="post">
                <div class="grid gap-4 mb-4 sm:grid-cols-2 sm:gap-6 sm:mb-5">
                    @if(!string.IsNullOrEmpty(Model.LogoUri))
                    {
                        <div class="sm:col-span-2">
                            <img class="w-20 h-20 rounded-full" src="@Model.LogoUri" alt="@Model.ClientName Logo">
                        </div>
                    }
                    <div class="sm:col-span-2">
                        <label for="updated" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Updated</label>
                        <input type="text" name="Updated" id="updated" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.Updated" readonly>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="lastAccessed" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Last Accessed</label>
                        <input type="text" name="LastAccessed" id="lastAccessed" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.LastAccessed" readonly>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="logoUri" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Logo Uri</label>
                        <input id="logoUri" name="LogoUri" type="text" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.LogoUri">
                    </div>
                    <div class="sm:col-span-2">
                        <label for="frontChannelLogoutUri" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Front Channel Logout Uri</label>
                        <input id="frontChannelLogoutUri" name="FrontChannelLogoutUri" type="text" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.FrontChannelLogoutUri">
                    </div>
                    <div class="sm:col-span-2">
                        <label for="clientName" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Client Name</label>
                        <input type="text" name="ClientName" id="clientName" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.ClientName" required>
                    </div>
                    <div class="w-full">
                        <label for="clientId" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Client ID</label>
                        <input type="text" name="ClientId" id="clientId" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.ClientId">
                    </div>

                    <!-- Lifetime and Expiration Settings -->
                    <div class="w-full">
                        <label asp-for="AccessTokenLifetime" for="accessTokenLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Access Token Lifetime (seconds)</label>
                        <input type="number" name="AccessTokenLifetime" id="accessTokenLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.AccessTokenLifetime" required>
                    </div>
                    <div class="w-full">
                        <label asp-for="AbsoluteRefreshTokenLifetime" for="absoluteRefreshTokenLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Absolute Refresh Token Lifetime (seconds)</label>
                        <input type="number" name="AbsoluteRefreshTokenLifetime" id="absoluteRefreshTokenLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.AbsoluteRefreshTokenLifetime" required>
                    </div>
                    <div class="w-full">
                        <label asp-for="AuthorizationCodeLifetime" for="authorizationCodeLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Authorization Code Lifetime (seconds)</label>
                        <input type="number" name="AuthorizationCodeLifetime" id="authorizationCodeLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.AuthorizationCodeLifetime" required>
                    </div>
                    <div class="w-full">
                        <label asp-for="DeviceCodeLifetime" for="deviceCodeLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Device Code Lifetime (seconds)</label>
                        <input type="number" name="DeviceCodeLifetime" id="deviceCodeLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.DeviceCodeLifetime" required>
                    </div>
                    <div class="w-full">
                        <label asp-for="SlidingRefreshTokenLifetime" for="slidingRefreshTokenLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Sliding Refresh Token Lifetime (seconds)</label>
                        <input type="number" name="SlidingRefreshTokenLifetime" id="slidingRefreshTokenLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.SlidingRefreshTokenLifetime" required>
                    </div>
                    <div class="w-full">
                        <label for="refreshTokenExpiration" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Refresh Token Expiration</label>
                        <select asp-for="RefreshTokenExpiration" name="RefreshTokenExpiration" id="refreshTokenExpiration" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                            <option value="@((int)TokenExpiration.Sliding)">@TokenExpiration.Sliding.ToString()</option>
                            <option value="@((int)TokenExpiration.Absolute)">@TokenExpiration.Absolute.ToString()</option>
                        </select>
                    </div>
                    <div class="w-full">
                        <label for="accessTokenType" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Access Token Type</label>
                        <select asp-for="AccessTokenType" name="AccessTokenType" id="accessTokenType" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                            <option value="@((int)AccessTokenType.Jwt)">@AccessTokenType.Jwt.ToString()</option>
                            <option value="@((int)AccessTokenType.Reference)">@AccessTokenType.Reference.ToString()</option>
                        </select>
                    </div>
                    <div class="w-full">
                        <label for="refreshTokenUsage" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Refresh Token Usage</label>
                        <select asp-for="RefreshTokenUsage" name="RefreshTokenUsage" id="refreshTokenUsage" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                            <option value="@((int)TokenUsage.ReUse)">@TokenUsage.ReUse.ToString()</option>
                            <option value="@((int)TokenUsage.OneTimeOnly)">@TokenUsage.OneTimeOnly.ToString()</option>
                        </select>
                    </div>

                    <!-- Options -->
                    <div>
                        <label for="enabled" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Enabled</label>
                        <input asp-for="Enabled" type="checkbox" name="Enabled" id="enabled" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="allowOfflineAccess" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Allow Offline Access</label>
                        <input asp-for="AllowOfflineAccess" type="checkbox" name="AllowOfflineAccess" id="allowOfflineAccess" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="allowAccessTokensViaBrowser" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Allow Access Tokens Via Browser</label>
                        <input asp-for="AllowAccessTokensViaBrowser" type="checkbox" name="AllowAccessTokensViaBrowser" id="allowAccessTokensViaBrowser" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="allowRememberConsent" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Allow Remember Consent</label>
                        <input asp-for="AllowRememberConsent" type="checkbox" name="AllowRememberConsent" id="allowRememberConsent" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="requireConsent" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Require Consent</label>
                        <input asp-for="RequireConsent" type="checkbox" name="RequireConsent" id="requireConsent" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="frontChannelLogoutSessionRequired" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Front Channel Logout Session Required</label>
                        <input asp-for="FrontChannelLogoutSessionRequired" type="checkbox" name="frontChannelLogoutSessionRequired" id="frontChannelLogoutSessionRequired" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="includeJwtId" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Include Jwt Id</label>
                        <input asp-for="IncludeJwtId" type="checkbox" name="includeJwtId" id="includeJwtId" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="alwaysIncludeUserClaimsInIdToken" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Always Include User Claims In Id Token</label>
                        <input asp-for="AlwaysIncludeUserClaimsInIdToken" type="checkbox" name="alwaysIncludeUserClaimsInIdToken" id="alwaysIncludeUserClaimsInIdToken" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="alwaysSendClientClaims" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Always Send Client Claims</label>
                        <input asp-for="AlwaysSendClientClaims" type="checkbox" name="alwaysSendClientClaims" id="alwaysSendClientClaims" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="requirePkce" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Require Pkce</label>
                        <input asp-for="RequirePkce" type="checkbox" name="requirePkce" id="requirePkce" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="allowPlainTextPkce" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Allow Plain Text Pkce</label>
                        <input asp-for="AllowPlainTextPkce" type="checkbox" name="allowPlainTextPkce" id="allowPlainTextPkce" class="rounded focus:ring-primary-600">
                    </div>
                    <div>
                        <label for="updateAccessTokenClaimsOnRefresh" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Update Access Token Claims On Refresh</label>
                        <input asp-for="UpdateAccessTokenClaimsOnRefresh" type="checkbox" name="updateAccessTokenClaimsOnRefresh" id="updateAccessTokenClaimsOnRefresh" class="rounded focus:ring-primary-600">
                    </div>

                    <div>
                        <label for="backChannelLogoutSessionRequired" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Back Channel Logout Session Required</label>
                        <input asp-for="BackChannelLogoutSessionRequired" type="checkbox" name="backChannelLogoutSessionRequired" id="backChannelLogoutSessionRequired" class="rounded focus:ring-primary-600">
                    </div>

                    <div>
                        <label for="enableLocalLogin" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Enable Local Login</label>
                        <input asp-for="EnableLocalLogin" type="checkbox" name="enableLocalLogin" id="enableLocalLogin" class="rounded focus:ring-primary-600">
                    </div>

                    <div>
                        <label for="requireClientSecret" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Require Client Secret</label>
                        <input asp-for="RequireClientSecret" type="checkbox" name="requireClientSecret" id="requireClientSecret" class="rounded focus:ring-primary-600">
                    </div>

                    <div>
                        <label for="requireRequestObject" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Require Request Object</label>
                        <input asp-for="RequireRequestObject" type="checkbox" name="requireRequestObject" id="requireRequestObject" class="rounded focus:ring-primary-600">
                    </div>

                    <div class="sm:col-span-2">
                        <label for="clientClaimsPrefix" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">ClientClaimsPrefix</label>
                        <input type="text" name="ClientClaimsPrefix" id="clientClaimsPrefix" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.ClientClaimsPrefix">
                    </div>

                    <!-- URIs -->
                    <div class="sm:col-span-2">
                        <label for="clientUri" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Client URI</label>
                        <input type="url" name="ClientUri" id="clientUri" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.ClientUri">
                    </div>

                    <div class="sm:col-span-2">
                        <label for="backChannelLogoutUri" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Back Channel Logout Uri</label>
                        <input type="url" name="BackChannelLogoutUri" id="backChannelLogoutUri" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.BackChannelLogoutUri">
                    </div>

                    <!-- Allowed CORS Origins -->
                    <div>
                        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Allowed CORS Origins</label>
                        <ul id="corsOriginsContainer">
                            @foreach (var item in Model.AllowedCorsOrigins)
                            {
                            <li class="sm:col-span-full item-entry">
                                <input type="url" name="AllowedCorsOrigins" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
                                       value="@item">
                                <button type="button" class="remove-item-button text-red-600 inline-flex items-center hover:text-white border border-red-600 hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:hover:bg-red-600 dark:focus:ring-red-900">
                                    <svg class="w-5 h-5 mr-1 -ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                    </svg>
                                    Remove
                                </button>
                            </li>
                            }
                        </ul>
                    </div>
                    <div class="sm:col-span-full">
                        <button type="button"
                                data-target-container="corsOriginsContainer"
                                data-template-id="corsOriginTemplate"
                                class="add-item-button relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-teal-300 to-lime-300 group-hover:from-teal-300 group-hover:to-lime-300 dark:text-white dark:hover:text-gray-900 focus:ring-4 focus:outline-none focus:ring-lime-200 dark:focus:ring-lime-800">
                            <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-opacity-0">
                                Add CORS Origin
                            </span>
                        </button>
                    </div>

                    <!-- PostLogoutRedirectUris -->
                    <div>
                        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Post Logout Redirect URIs</label>
                        <ul id="postLogoutRedirectUrisContainer">
                            @foreach (var item in Model.PostLogoutRedirectUris)
                            {
                            <li class="sm:col-span-full item-entry">
                                <input type="url" name="PostLogoutRedirectUris" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
                                       value="@item">
                                <button type="button" class="remove-item-button text-red-600 inline-flex items-center hover:text-white border border-red-600 hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:hover:bg-red-600 dark:focus:ring-red-900">
                                    <svg class="w-5 h-5 mr-1 -ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                    </svg>
                                    Remove
                                </button>
                            </li>
                            }
                        </ul>
                    </div>
                    <div class="sm:col-span-full">
                        <button type="button"
                                data-target-container="postLogoutRedirectUrisContainer"
                                data-template-id="postLogoutRedirectUriTemplate"
                                class="add-item-button relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-teal-300 to-lime-300 group-hover:from-teal-300 group-hover:to-lime-300 dark:text-white dark:hover:text-gray-900 focus:ring-4 focus:outline-none focus:ring-lime-200 dark:focus:ring-lime-800">
                            <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-opacity-0">
                                Add Post Logout Redirect URI
                            </span>
                        </button>
                    </div>

                    <!-- RedirectUris -->
                    <div>
                        <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Redirect URIs</label>
                        <ul id="redirectUrisContainer">
                            @foreach (var item in Model.RedirectUris)
                            {
                            <li class="sm:col-span-full item-entry">
                                <input type="url" name="RedirectUris" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
                                       value="@item">
                                <button type="button" class="remove-item-button text-red-600 inline-flex items-center hover:text-white border border-red-600 hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:hover:bg-red-600 dark:focus:ring-red-900">
                                    <svg class="w-5 h-5 mr-1 -ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                    </svg>
                                    Remove
                                </button>
                            </li>
                            }
                        </ul>
                    </div>
                    <div class="sm:col-span-full">
                        <button type="button"
                                data-target-container="redirectUrisContainer"
                                data-template-id="redirectUriTemplate"
                                class="add-item-button relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-sm font-medium text-gray-900 rounded-lg group bg-gradient-to-br from-teal-300 to-lime-300 group-hover:from-teal-300 group-hover:to-lime-300 dark:text-white dark:hover:text-gray-900 focus:ring-4 focus:outline-none focus:ring-lime-200 dark:focus:ring-lime-800">
                            <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-opacity-0">
                                Add Redirect URI
                            </span>
                        </button>
                    </div>

                    <!-- Templates -->
                    <template id="corsOriginTemplate">
                        <li class="sm:col-span-full item-entry">
                            <input type="url" name="AllowedCorsOrigins" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
                                   placeholder="Enter a CORS origin">
                            <button type="button" class="remove-item-button text-red-600 inline-flex items-center hover:text-white border border-red-600 hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:border-red-500 dark:text-red-500 dark:hover:text-white dark:hover:bg-red-600 dark:focus:ring-red-900">
                                <svg class="w-5 h-5 mr-1 -ml-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                </svg>
                                Remove
                            </button>
                        </li>
                    </template>

                    <template id="postLogoutRedirectUriTemplate">
                        <li class="sm:col-span-full item-entry">
