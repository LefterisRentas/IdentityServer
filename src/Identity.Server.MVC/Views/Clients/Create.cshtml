                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                </svg>
                                Remove
                            </button>
                        </li>
                    </template>

                    <!-- Protocol and Token Settings -->
                    <div class="w-full">
                        <label for="protocolType" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Protocol Type</label>
                        <input type="text" name="ProtocolType" id="protocolType" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.ProtocolType">
                    </div>
                    <div class="w-full">
                        <label for="identityTokenLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Identity Token Lifetime (seconds)</label>
                        <input type="number" name="IdentityTokenLifetime" id="identityTokenLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.IdentityTokenLifetime">
                    </div>
                    <div class="w-full">
                        <label for="consentLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Consent Lifetime (seconds)</label>
                        <input type="number" name="ConsentLifetime" id="consentLifetime"
                               class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
                               value="@Model.ConsentLifetime">
                    </div>
                    <div class="w-full">
                        <label for="userSsoLifetime" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">User SSO Lifetime (seconds)</label>
                        <input type="number" name="UserSsoLifetime" id="userSsoLifetime" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" value="@Model.UserSsoLifetime">
                    </div>

                    <!-- Additional Settings -->
                    <div class="sm:col-span-2">
                        <label for="pairWiseSubjectSalt" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Pair Wise Subject Salt</label>
                        <textarea id="pairWiseSubjectSalt" name="PairWiseSubjectSalt" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">@Model.PairWiseSubjectSalt</textarea>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="userCodeType" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">User Code Type</label>
                        <textarea id="userCodeType" name="UserCodeType" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">@Model.UserCodeType</textarea>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                        <textarea id="description" name="Description" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">@Model.Description</textarea>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center space-x-4">
                    <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
                        Create Client
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>