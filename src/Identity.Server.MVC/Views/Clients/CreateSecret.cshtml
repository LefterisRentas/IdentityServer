@using Identity.Server.Extended.Models.Clients
@using IdentityServer4
@model Identity.Server.Extended.Models.Clients.ClientSecretDto

@{
    ViewData["Title"] = "Create Client Secret";
    ViewData["Description"] = "Create a new secret for the client.";
}

<div class="container mx-auto px-4 py-6 md:flex">
    <partial name="_ManagementNav" />

    <section class="bg-white dark:bg-gray-900">
        <div class="max-w-2xl px-4 py-8 mx-auto lg:py-16">
            <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Create Client Secret</h2>
            <form asp-action="CreateSecret" method="post">
                <div class="grid gap-4 mb-4 sm:grid-cols-2 sm:gap-6 sm:mb-5">
                    <div class="sm:col-span-2">
                        <label for="Type" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Secret Type</label>
                        <select id="Type" name="Type" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                            <option value="@IdentityServerConstants.SecretTypes.SharedSecret" selected>Shared Secret</option>
                            <option value="@IdentityServerConstants.SecretTypes.X509CertificateThumbprint">X.509 Thumbprint</option>
                            <option value="@IdentityServerConstants.SecretTypes.X509CertificateName">X.509 Name</option>
                            <option value="@IdentityServerConstants.SecretTypes.X509CertificateBase64">X.509 Certificate Base64</option>
                            <option value="@IdentityServerConstants.SecretTypes.JsonWebKey">Json Web Key</option>
                        </select>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="Description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                        <input type="text" id="Description" name="Description" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" placeholder="Enter a description for the secret">
                    </div>

                    <div class="sm:col-span-2">
                        <label for="Value" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Secret Value</label>
                        <input type="password" id="Value" name="Value" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" placeholder="Enter the secret value" required>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="HashType" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Hash Type</label>
                        <select id="HashType" name="HashType" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                            <option value="@ClientSecretHashType.Unavailable">Unavailable</option>
                            <option value="@ClientSecretHashType.Sha256" selected>SHA-256</option>
                            <option value="@ClientSecretHashType.Sha512">SHA-512</option>
                        </select>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="Expiration" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Expiration Date (optional)</label>
                        <input type="datetime-local" id="Expiration" name="Expiration" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white">
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <button type="submit" class="text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800">
                        Create Secret
                    </button>
                    <a href="@Url.Action("Secrets", "Clients", new { clientId = ViewBag.ClientId })" class="text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white focus:ring-4 focus:outline-none focus:ring-gray-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:focus:ring-gray-700">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </section>
</div>
